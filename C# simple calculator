        if(option < 1 || option > max)
        {
            Console.WriteLine("Invalid option. Try again");
            continue;
        }
        else
        {
            return option;
        }
        }while(repeat == true);
        return 0;
    }
    
    static bool repeat() //repeat the calculator to do it again
    {
